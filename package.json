{
  "name": "sneakers-shop-saas",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint",
    "format:web": "prettier --write \"**/*.{ts,tsx,md,json,cs}\"",
    "format:web:check": "prettier --check \"**/*.{ts,tsx,md,json,cs}\"",
    "check:format:dotnet": "dotnet format ./backend --verify-no-changes -v diag",
    "dev:api": "concurrently \"pnpm run dev:web\" \"dotnet run --project ./backend/src/SneakersShop.API.csproj\"",
    "dev:migrations": "dotnet run --project ./backend/src/SneakersShop.Migrations/SneakersShop.Migrations.csproj",
    "dev:compose:up": "docker-compose -f infra/docker-compose.dev.yml up --build",
    "dev:compose:down": "docker-compose -f infra/docker-compose.dev.yml down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.9",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5"
  },
  "type": "module"
}
